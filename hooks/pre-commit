#!/bin/bash
# pre-commit — redaction scan + bilingual-doc pairing check.
# Install: ln -sf ../../hooks/pre-commit .git/hooks/pre-commit
set -e
cd "$(git rev-parse --show-toplevel)"

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED" ] && exit 0

fail=0

# ---- 1. Redaction scan (staged content, not just filenames) ----------------
# The rules live in tests/redaction_scan.py, which CI runs too. They used to live here AND
# in .github/workflows/redaction-check.yml as two hand-copied regex lists with two different
# file-selection schemes, and they had drifted: this hook skipped by extension DENYLIST
# (which omitted .mp3, so it text-grepped audio and blocked on entropy) while CI skipped by
# extension ALLOWLIST (which omitted .html/.js, so CI never opened them). One module now, so
# a rule added for one scanner cannot be missing from the other.
#
# A missing scanner is a FAILURE, not a skip — same reasoning as the SVG block below. rc=2
# means "could not look", which must never read as "looked and it is fine".
if [ ! -f tests/redaction_scan.py ]; then
  echo "✗ REDACTION: tests/redaction_scan.py is missing — staged content cannot be verified"
  fail=1
elif ! command -v python3 >/dev/null; then
  echo "✗ REDACTION: python3 not found, cannot verify staged content"
  fail=1
else
  python3 tests/redaction_scan.py --staged || fail=1
fi

# ---- 2. Bilingual pairing: staged EN doc with a zh-TW twin must stage both --
for f in $STAGED; do
  case "$f" in
    README.md|docs/ARCHITECTURE.md|docs/CASE_STUDY.md)
      twin="${f%.md}.zh-TW.md"
      if [ -f "$twin" ] && ! echo "$STAGED" | grep -qx "$twin"; then
        echo "✗ BILINGUAL: $f staged but its twin $twin is not (repo rule: update both in the same commit)"
        fail=1
      fi
      ;;
    README.zh-TW.md|docs/ARCHITECTURE.zh-TW.md|docs/CASE_STUDY.zh-TW.md)
      twin="${f%.zh-TW.md}.md"
      if [ -f "$twin" ] && ! echo "$STAGED" | grep -qx "$twin"; then
        echo "✗ BILINGUAL: $f staged but its twin $twin is not"
        fail=1
      fi
      ;;
  esac
done

# ---- 3. SVGs must pass the geometry check if staged ------------------------
# The checker's absence used to SKIP this block silently, which made the hook
# depend on a filename: renaming the file (check_svg_geometry.py ->
# test_svg_geometry.py, so pytest would actually collect it) disabled the hook
# and nothing said so. A missing guard is a failure, not a reason to proceed.
if echo "$STAGED" | grep -qE 'docs/architecture.*\.svg'; then
  if ! command -v python3 >/dev/null; then
    echo "✗ SVG: python3 not found, cannot verify staged diagram geometry"
    fail=1
  elif [ ! -f tests/test_svg_geometry.py ]; then
    echo "✗ SVG: tests/test_svg_geometry.py is missing — diagrams cannot be verified"
    fail=1
  else
    python3 tests/test_svg_geometry.py $(echo "$STAGED" | grep -E 'docs/architecture.*\.svg') || fail=1
  fi
fi

if [ $fail -ne 0 ]; then
  echo ""
  echo "Commit blocked. Fix the issues above (see AGENTS.md security rules)."
  exit 1
fi
exit 0
