{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:REGION:ACCOUNT_ID:*"
    },
    {
      "Sid": "AgentCoreControl",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:ListHarnesses",
        "bedrock-agentcore:GetHarness",
        "bedrock-agentcore:UpdateHarness",
        "bedrock-agentcore:ListAgentRuntimes"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EvalRead",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:ListEvaluators",
        "bedrock-agentcore:GetEvaluator",
        "bedrock-agentcore:ListOnlineEvaluationConfigs",
        "bedrock-agentcore:GetOnlineEvaluationConfig"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BatchEval",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:StartBatchEvaluation",
        "bedrock-agentcore:GetBatchEvaluation",
        "bedrock-agentcore:ListBatchEvaluations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NativeRecs",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:StartRecommendation",
        "bedrock-agentcore:GetRecommendation",
        "bedrock-agentcore:ListRecommendations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "StepFunctionsRead",
      "Effect": "Allow",
      "Action": [
        "states:ListExecutions",
        "states:DescribeStateMachine"
      ],
      "Resource": "arn:aws:states:REGION:ACCOUNT_ID:stateMachine:llmops-pipeline"
    },
    {
      "Sid": "StepFunctionsExecRead",
      "Effect": "Allow",
      "Action": [
        "states:DescribeExecution",
        "states:GetExecutionHistory"
      ],
      "Resource": "arn:aws:states:REGION:ACCOUNT_ID:execution:llmops-pipeline:*"
    },
    {
      "Sid": "SageMakerRead",
      "Effect": "Allow",
      "Action": [
        "sagemaker:DescribeTrainingJob",
        "sagemaker:ListTrainingJobs",
        "sagemaker:DescribeEndpoint",
        "sagemaker:ListEndpoints"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CWMetricsRead",
      "Effect": "Allow",
      "Action": ["cloudwatch:GetMetricData", "cloudwatch:ListMetrics"],
      "Resource": "*"
    },
    {
      "Sid": "AgentCoreLogsRead",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogStreams",
        "logs:StartQuery",
        "logs:GetQueryResults",
        "logs:FilterLogEvents",
        "logs:GetLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/bedrock-agentcore*",
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/bedrock-agentcore*:*",
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:aws/spans",
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:aws/spans:*"
      ]
    },
    {
      "Sid": "LogsDescribeAndFas",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:PutRetentionPolicy",
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Bedrock",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": "*"
    },
    {
      "Sid": "S3Manifests",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": "*"
    },
    {
      "Sid": "SsmParams",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/llmops/*"
    },
    {
      "Sid": "Secrets",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:llmops-admin/*"
    },
    {
      "Sid": "DDBConsole",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:GetItem", "dynamodb:Scan"],
      "Resource": "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/LlmopsAdminRuns"
    },
    {
      "Sid": "DDBPipelineRead",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:Query", "dynamodb:Scan"],
      "Resource": [
        "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/llmops-pipeline-runs",
        "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/llmops-stage-events"
      ]
    },
    {
      "_comment": "Estimates and approval decisions: the console writes them. Actuals are written only by the finops agent via the driver, so the console reads them and never writes — a dashboard that can edit reconciled cost is not an audit trail.",
      "Sid": "DDBCostEstimates",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:GetItem", "dynamodb:Query", "dynamodb:Scan"],
      "Resource": [
        "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/llmops-cost-estimates",
        "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/llmops-cost-estimates/index/*"
      ]
    },
    {
      "Sid": "DDBCostActualsRead",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:Query"],
      "Resource": "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/llmops-cost-actuals"
    },
    {
      "_comment": "Read-only on billing, deliberately. ce:* and pricing:* have no resource-level ARNs so Resource must be * — the scoping is that only Get/List/Describe verbs appear here. budgets:DescribeBudgets surfaces the existing $1000 account guardrail rather than duplicating it.",
      "Sid": "BillingRead",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage",
        "ce:GetCostAndUsageWithResources",
        "ce:GetDimensionValues",
        "ce:GetTags",
        "ce:ListCostAllocationTags",
        "pricing:GetProducts",
        "pricing:GetAttributeValues",
        "pricing:DescribeServices",
        "budgets:DescribeBudgets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InvokeStartPipelineAndSelf",
      "Effect": "Allow",
      "Action": ["lambda:InvokeFunction"],
      "Resource": [
        "arn:aws:lambda:REGION:ACCOUNT_ID:function:llmops-start-pipeline",
        "arn:aws:lambda:REGION:ACCOUNT_ID:function:llmops-finops-reconcile",
        "arn:aws:lambda:REGION:ACCOUNT_ID:function:llmops-admin"
      ]
    },
    {
      "_comment": "AdminListGroupsForUser is required for the approver check: GetUser returns the username and attributes but NOT group membership, and a bearer access token carries no cognito:groups claim. Without this call the separation-of-duties gate has nothing to check.",
      "Sid": "CognitoAuth",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:InitiateAuth",
        "cognito-idp:GetUser",
        "cognito-idp:AdminListGroupsForUser"
      ],
      "Resource": "*"
    },
    {
      "Sid": "STS",
      "Effect": "Allow",
      "Action": ["sts:GetCallerIdentity"],
      "Resource": "*"
    }
  ]
}
