{
  "_comment": "Execution role for an AgentCore Harness. Two documents below: the trust policy (who can assume the role) and the permissions policy (what the harness may do). Replace <REGION>, <ACCOUNT_ID>, <MEMORY_ID>, and the model id as needed. Statements labeled 'Baseline*' are required for the harness session to start at all (loader image pull, workload identity, telemetry). ManagedMemoryEvents is REQUIRED whenever managed memory is on (the default): the harness auto-creates a Memory and InvokeHarness fails with AccessDeniedException on ListEvents without it (verified live). The Memory's name was harness_<name>_<4hex>-<10> through 2026-08-04 and is <harnessName>-<10> from 2026-08-11, which the memory/harness_* resource below does NOT match; managed memory is also what a create gets when it omits `memory`, so the llmops configs declare {\"disabled\": {}} (AGENTS.md). The BYOMemory* statements apply only to bring-your-own memory (agentCoreMemoryConfiguration); scripts/wire_memory.py adds them per-Memory. NOTE dual CALLER permissions (separate from this execution role): invoking needs bedrock-agentcore:InvokeHarness AND InvokeAgentRuntime; creating needs CreateHarness AND CreateAgentRuntime (+ CreateMemory for BYO). See references/gotchas.md.",

  "trustPolicy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "AllowAgentCoreToAssume",
        "Effect": "Allow",
        "Principal": { "Service": "bedrock-agentcore.amazonaws.com" },
        "Action": "sts:AssumeRole",
        "Condition": {
          "StringEquals": { "aws:SourceAccount": "<ACCOUNT_ID>" }
        }
      }
    ]
  },

  "permissionsPolicy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "BaselineImagePull",
        "Effect": "Allow",
        "Action": [
          "ecr-public:GetAuthorizationToken",
          "sts:GetServiceBearerToken"
        ],
        "Resource": "*"
      },
      {
        "Sid": "BaselineWorkloadIdentity",
        "Effect": "Allow",
        "Action": [
          "bedrock-agentcore:GetWorkloadAccessToken",
          "bedrock-agentcore:GetWorkloadAccessTokenForJWT"
        ],
        "Resource": "arn:aws:bedrock-agentcore:<REGION>:<ACCOUNT_ID>:workload-identity-directory/*"
      },
      {
        "Sid": "BaselineTelemetry",
        "Effect": "Allow",
        "Action": [
          "xray:PutTraceSegments",
          "xray:PutTelemetryRecords",
          "cloudwatch:PutMetricData"
        ],
        "Resource": "*"
      },
      {
        "Sid": "BaselineLogs",
        "Effect": "Allow",
        "Action": [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:PutLogEvents",
          "logs:DescribeLogGroups",
          "logs:DescribeLogStreams"
        ],
        "Resource": "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:/aws/bedrock-agentcore/*"
      },
      {
        "Sid": "InvokeModel",
        "Effect": "Allow",
        "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
        "Resource": [
          "arn:aws:bedrock:*::foundation-model/*",
          "arn:aws:bedrock:*:<ACCOUNT_ID>:inference-profile/*"
        ]
      },
      {
        "Sid": "BuiltinBrowserSessions",
        "Effect": "Allow",
        "Action": [
          "bedrock-agentcore:StartBrowserSession",
          "bedrock-agentcore:StopBrowserSession",
          "bedrock-agentcore:UpdateBrowserStream",
          "bedrock-agentcore:GetBrowserSession"
        ],
        "Resource": "arn:aws:bedrock-agentcore:<REGION>:aws:browser/*"
      },
      {
        "Sid": "BuiltinCodeInterpreterSessions",
        "Effect": "Allow",
        "Action": [
          "bedrock-agentcore:StartCodeInterpreterSession",
          "bedrock-agentcore:StopCodeInterpreterSession",
          "bedrock-agentcore:InvokeCodeInterpreter"
        ],
        "Resource": "arn:aws:bedrock-agentcore:<REGION>:aws:code-interpreter/*"
      },
      {
        "Sid": "ManagedMemoryEvents",
        "Effect": "Allow",
        "Action": [
          "bedrock-agentcore:CreateEvent",
          "bedrock-agentcore:DeleteEvent",
          "bedrock-agentcore:GetEvent",
          "bedrock-agentcore:ListEvents",
          "bedrock-agentcore:RetrieveMemoryRecords"
        ],
        "Resource": "arn:aws:bedrock-agentcore:<REGION>:<ACCOUNT_ID>:memory/harness_*"
      },
      {
        "Sid": "BYOMemoryEvents",
        "Effect": "Allow",
        "Action": [
          "bedrock-agentcore:CreateEvent",
          "bedrock-agentcore:DeleteEvent",
          "bedrock-agentcore:GetEvent",
          "bedrock-agentcore:ListEvents"
        ],
        "Resource": "arn:aws:bedrock-agentcore:<REGION>:<ACCOUNT_ID>:memory/<MEMORY_ID>"
      },
      {
        "Sid": "BYOMemoryRetrieval",
        "Effect": "Allow",
        "Action": [
          "bedrock-agentcore:RetrieveMemoryRecords"
        ],
        "Resource": "arn:aws:bedrock-agentcore:<REGION>:<ACCOUNT_ID>:memory/<MEMORY_ID>",
        "Condition": {
          "StringLike": {
            "bedrock-agentcore:namespace": [
              "/episodes/*/*",
              "/users/*/preferences",
              "/summaries/*/*",
              "/users/*/facts"
            ]
          }
        }
      }
    ]
  }
}
