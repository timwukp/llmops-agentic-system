{
  "_comment": "Execution role for ALL 5 llmops worker harnesses (data-prep, finetune, eval, deploy, monitor). Extends deploy/iam/execution_role_base.json (the agentcore-harness-builder skill baseline) with the pipeline's needs: S3 run/report/skills-mirror prefixes, teacher-model Bedrock access (DeepSeek-R1), scoped SageMaker lifecycle + model registry, CloudWatch/Logs read for monitoring, and the llmops-pipeline event bus. Placeholders <REGION>, <ACCOUNT_ID>, <DATA_BUCKET>, <MEMORY_ID> are substituted by deploy/01_iam.py at deploy time (account id from sts get-caller-identity — never committed). SCOPING NOTE: the base's InvokeModel statement was foundation-model/* + inference-profile/* — here it is narrowed to exactly the models this pipeline uses (anthropic.* for the harness model global.anthropic.claude-sonnet-5 incl. cross-region routing targets, deepseek.r1* as the distillation teacher), so the teacher grant is NOT a duplicate statement but a narrowing of the base one. BYOMemory* statements are dropped by 01_iam.py unless --memory-id is passed (deploy/wire_memory.py re-adds them per-Memory later, matching the base's contract). Statements with Resource '*' (BaselineImagePull, BaselineTelemetry, SageMakerList, CloudWatchMetricsRead) are actions that do not support resource-level permissions.",

  "trustPolicy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "AllowAgentCoreToAssume",
        "Effect": "Allow",
        "Principal": { "Service": "bedrock-agentcore.amazonaws.com" },
        "Action": "sts:AssumeRole",
        "Condition": {
          "StringEquals": { "aws:SourceAccount": "<ACCOUNT_ID>" }
        }
      }
    ]
  },

  "permissionsPolicy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "BaselineImagePull",
        "Effect": "Allow",
        "Action": [
          "ecr-public:GetAuthorizationToken",
          "sts:GetServiceBearerToken"
        ],
        "Resource": "*"
      },
      {
        "Sid": "BaselineWorkloadIdentity",
        "Effect": "Allow",
        "Action": [
          "bedrock-agentcore:GetWorkloadAccessToken",
          "bedrock-agentcore:GetWorkloadAccessTokenForJWT"
        ],
        "Resource": "arn:aws:bedrock-agentcore:<REGION>:<ACCOUNT_ID>:workload-identity-directory/*"
      },
      {
        "Sid": "BaselineTelemetry",
        "Effect": "Allow",
        "Action": [
          "xray:PutTraceSegments",
          "xray:PutTelemetryRecords",
          "cloudwatch:PutMetricData"
        ],
        "Resource": "*"
      },
      {
        "Sid": "BaselineLogs",
        "Effect": "Allow",
        "Action": [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:PutLogEvents",
          "logs:DescribeLogGroups",
          "logs:DescribeLogStreams"
        ],
        "Resource": "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:/aws/bedrock-agentcore/*"
      },
      {
        "Sid": "InvokeModel",
        "Effect": "Allow",
        "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
        "Resource": [
          "arn:aws:bedrock:*::foundation-model/anthropic.*",
          "arn:aws:bedrock:*::foundation-model/deepseek.r1*",
          "arn:aws:bedrock:*:<ACCOUNT_ID>:inference-profile/global.anthropic.*",
          "arn:aws:bedrock:*:<ACCOUNT_ID>:inference-profile/us.anthropic.*",
          "arn:aws:bedrock:*:<ACCOUNT_ID>:inference-profile/us.deepseek.r1*"
        ]
      },
      {
        "Sid": "BuiltinBrowserSessions",
        "Effect": "Allow",
        "Action": [
          "bedrock-agentcore:StartBrowserSession",
          "bedrock-agentcore:StopBrowserSession",
          "bedrock-agentcore:UpdateBrowserStream",
          "bedrock-agentcore:GetBrowserSession"
        ],
        "Resource": "arn:aws:bedrock-agentcore:<REGION>:aws:browser/*"
      },
      {
        "Sid": "BuiltinCodeInterpreterSessions",
        "Effect": "Allow",
        "Action": [
          "bedrock-agentcore:StartCodeInterpreterSession",
          "bedrock-agentcore:StopCodeInterpreterSession",
          "bedrock-agentcore:InvokeCodeInterpreter"
        ],
        "Resource": "arn:aws:bedrock-agentcore:<REGION>:aws:code-interpreter/*"
      },
      {
        "Sid": "ManagedMemoryEvents",
        "Effect": "Allow",
        "Action": [
          "bedrock-agentcore:CreateEvent",
          "bedrock-agentcore:DeleteEvent",
          "bedrock-agentcore:GetEvent",
          "bedrock-agentcore:ListEvents",
          "bedrock-agentcore:RetrieveMemoryRecords"
        ],
        "Resource": "arn:aws:bedrock-agentcore:<REGION>:<ACCOUNT_ID>:memory/harness_*"
      },
      {
        "Sid": "BYOMemoryEvents",
        "Effect": "Allow",
        "Action": [
          "bedrock-agentcore:CreateEvent",
          "bedrock-agentcore:DeleteEvent",
          "bedrock-agentcore:GetEvent",
          "bedrock-agentcore:ListEvents"
        ],
        "Resource": "arn:aws:bedrock-agentcore:<REGION>:<ACCOUNT_ID>:memory/<MEMORY_ID>"
      },
      {
        "Sid": "BYOMemoryRetrieval",
        "Effect": "Allow",
        "Action": [
          "bedrock-agentcore:RetrieveMemoryRecords"
        ],
        "Resource": "arn:aws:bedrock-agentcore:<REGION>:<ACCOUNT_ID>:memory/<MEMORY_ID>",
        "Condition": {
          "StringLike": {
            "bedrock-agentcore:namespace": [
              "/episodes/*/*",
              "/users/*/preferences",
              "/summaries/*/*",
              "/users/*/facts"
            ]
          }
        }
      },
      {
        "_comment": "finops/* and contracts/* are the audit runtime's two paths and were both missing until a live pricing_refresh proved it: the agent derived a complete 37-SKU rate card, then failed to write it (PutObject denied on finops/rates/rate_card_latest.json) AND failed to load the canonical cost_model.py (GetObject denied on contracts/), so it published nothing and stamped its own output non-canonical. A prefix nobody granted is a feature that runs to completion and then throws its work away.",
        "Sid": "S3PipelineObjects",
        "Effect": "Allow",
        "Action": ["s3:GetObject", "s3:PutObject"],
        "Resource": [
          "arn:aws:s3:::<DATA_BUCKET>/runs/*",
          "arn:aws:s3:::<DATA_BUCKET>/reports/*",
          "arn:aws:s3:::<DATA_BUCKET>/skills-mirror/*",
          "arn:aws:s3:::<DATA_BUCKET>/finops/*",
          "arn:aws:s3:::<DATA_BUCKET>/contracts/*"
        ]
      },
      {
        "_comment": "The prefix list must match S3PipelineObjects: ListBucket is condition-scoped, so a prefix granted for Get/Put but absent here can be read object-by-object and never enumerated -- which is exactly the shape of 'the rate card history is there but the agent reports no card exists'.",
        "Sid": "S3PipelineList",
        "Effect": "Allow",
        "Action": ["s3:ListBucket"],
        "Resource": "arn:aws:s3:::<DATA_BUCKET>",
        "Condition": {
          "StringLike": {
            "s3:prefix": ["runs/*", "reports/*", "skills-mirror/*",
                          "finops/*", "contracts/*"]
          }
        }
      },
      {
        "Sid": "SageMakerLifecycleScoped",
        "Effect": "Allow",
        "Action": [
          "sagemaker:CreateTrainingJob",
          "sagemaker:DescribeTrainingJob",
          "sagemaker:StopTrainingJob",
          "sagemaker:CreateModel",
          "sagemaker:CreateEndpointConfig",
          "sagemaker:CreateEndpoint",
          "sagemaker:UpdateEndpoint",
          "sagemaker:DeleteEndpoint",
          "sagemaker:DescribeEndpoint",
          "sagemaker:InvokeEndpoint",
          "sagemaker:AddTags"
        ],
        "Resource": [
          "arn:aws:sagemaker:<REGION>:<ACCOUNT_ID>:training-job/llmops-*",
          "arn:aws:sagemaker:<REGION>:<ACCOUNT_ID>:model/llmops-*",
          "arn:aws:sagemaker:<REGION>:<ACCOUNT_ID>:endpoint-config/llmops-*",
          "arn:aws:sagemaker:<REGION>:<ACCOUNT_ID>:endpoint/llmops-*"
        ]
      },
      {
        "Sid": "SageMakerModelRegistryScoped",
        "Effect": "Allow",
        "Action": [
          "sagemaker:CreateModelPackage",
          "sagemaker:CreateModelPackageGroup",
          "sagemaker:DescribeModelPackage",
          "sagemaker:DescribeModelPackageGroup"
        ],
        "Resource": [
          "arn:aws:sagemaker:<REGION>:<ACCOUNT_ID>:model-package/llmops-*",
          "arn:aws:sagemaker:<REGION>:<ACCOUNT_ID>:model-package-group/llmops-*"
        ]
      },
      {
        "Sid": "SageMakerList",
        "Effect": "Allow",
        "Action": [
          "sagemaker:ListEndpoints",
          "sagemaker:ListTrainingJobs"
        ],
        "Resource": "*"
      },
      {
        "Sid": "PassSageMakerExecutionRoleOnly",
        "Effect": "Allow",
        "Action": "iam:PassRole",
        "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/llmops-sagemaker-execution",
        "Condition": {
          "StringEquals": { "iam:PassedToService": "sagemaker.amazonaws.com" }
        }
      },
      {
        "Sid": "CloudWatchMetricsRead",
        "Effect": "Allow",
        "Action": [
          "cloudwatch:GetMetricData",
          "cloudwatch:ListMetrics"
        ],
        "Resource": "*"
      },
      {
        "Sid": "SageMakerLogsRead",
        "Effect": "Allow",
        "Action": [
          "logs:GetLogEvents",
          "logs:DescribeLogStreams",
          "logs:FilterLogEvents"
        ],
        "Resource": [
          "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:/aws/sagemaker/*",
          "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:/aws/sagemaker/*:log-stream:*"
        ]
      },
      {
        "Sid": "PutPipelineEvents",
        "Effect": "Allow",
        "Action": "events:PutEvents",
        "Resource": "arn:aws:events:<REGION>:<ACCOUNT_ID>:event-bus/llmops-pipeline"
      },
      {
        "_comment": "For llmops_finops (the audit runtime). READ-ONLY on billing, by design: an auditor able to change what it audits is not an auditor. Every verb here is Get/List/Describe -- notably NO ce:CreateCostCategoryDefinition, NO ce:UpdateCostAllocationTagsStatus, NO budgets:ModifyBudget. Resource must be * because ce:* and pricing:* have no resource-level ARNs; the scoping is the verb list. All six harnesses share this role, so the other five gain read-only billing visibility they do not use -- the alternative is a second execution role, which the harness create path does not support today.",
        "Sid": "BillingReadOnlyForFinOps",
        "Effect": "Allow",
        "Action": [
          "ce:GetCostAndUsage",
          "ce:GetCostAndUsageWithResources",
          "ce:GetDimensionValues",
          "ce:GetTags",
          "ce:GetCostForecast",
          "ce:ListCostAllocationTags",
          "pricing:GetProducts",
          "pricing:GetAttributeValues",
          "pricing:DescribeServices",
          "budgets:DescribeBudgets"
        ],
        "Resource": "*"
      },
      {
        "_comment": "The finops agent reads estimates to compare against, and reads/writes the actuals ledger it owns. It must NOT be able to change an approval decision, so no write verbs on llmops-cost-estimates -- an auditor that can flip a rejected estimate to approved has defeated the gate.",
        "Sid": "CostLedgerForFinOps",
        "Effect": "Allow",
        "Action": [
          "dynamodb:GetItem",
          "dynamodb:Query",
          "dynamodb:Scan"
        ],
        "Resource": [
          "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/llmops-cost-estimates",
          "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/llmops-cost-estimates/index/*"
        ]
      },
      {
        "Sid": "CostActualsLedgerForFinOps",
        "Effect": "Allow",
        "Action": [
          "dynamodb:GetItem",
          "dynamodb:Query",
          "dynamodb:PutItem",
          "dynamodb:UpdateItem"
        ],
        "Resource": "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/llmops-cost-actuals"
      }
    ]
  }
}
