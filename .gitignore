__pycache__/
*.pyc
# Both spellings on purpose. `.venv/` alone matches a DIRECTORY; in a throwaway worktree
# .venv is often a SYMLINK to a shared one, which the trailing slash does not match -- so
# `git add -A` staged it as a mode-120000 entry pointing at a path on one laptop. The
# redaction gate passed it, correctly: a dangling symlink is not a credential.
.venv
.venv/
.DS_Store
deploy/evidence/*.local.*
pipeline/v2/out/
# Written by tests/negative_controls/monitor_dispatch.py while one file is mutated, so a
# run killed mid-case can restore it on the next start. Never committed: it holds the
# pristine copy of a tracked source file, and committing it would be committing a duplicate.
.negative_control_journal

# The intro page is GENERATED (deploy/console/intro/build_intro.py --out build/intro.html)
# by deploy.sh and by tests/test_intro_player.js. Committing it would give the repo a second,
# staler copy of a file whose inputs are already tracked.
build/

# tools/audit_drift.py --json. Holds live ARNs, and therefore this account's id: the
# redaction scanner guards tracked files, so the answer is to never track this one.
/drift-audit*.json
