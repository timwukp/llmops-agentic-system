{
  "Comment": "llmops-pipeline \u2014 stage DAG with waitForTaskToken per harness task and the self-iteration remediation loop (eval gate fail -> remediate finetune, <=3 iterations, then escalate).",
  "StartAt": "PipelineModeChoice",
  "States": {
    "PipelineModeChoice": {
      "Type": "Choice",
      "Comment": "data_audit is the conductor's starter: audit the customer's data and stop \u2014 no GPU stage may run. Default full pipeline otherwise.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.pipeline_mode",
              "IsPresent": true
            },
            {
              "Variable": "$.pipeline_mode",
              "StringEquals": "data_audit"
            }
          ],
          "Next": "DataAudit"
        }
      ],
      "Default": "DataPrepGenerate"
    },
    "DataAudit": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${HarnessDriverArn}",
        "Payload": {
          "run_id.$": "$.run_id",
          "manifest_uri.$": "$.manifest_uri",
          "stage": "data-prep",
          "task": "audit",
          "harness_id": "llmops_data_prep",
          "task_token.$": "$$.Task.Token",
          "iteration.$": "$.iteration"
        }
      },
      "ResultPath": "$.data_audit",
      "TimeoutSeconds": 3600,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.TooManyRequestsException",
            "Lambda.AWSLambdaException"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "EscalateFail"
        }
      ],
      "Next": "Complete"
    },
    "DataPrepGenerate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${HarnessDriverArn}",
        "Payload": {
          "run_id.$": "$.run_id",
          "manifest_uri.$": "$.manifest_uri",
          "stage": "data-prep",
          "task": "generate",
          "harness_id": "llmops_data_prep",
          "task_token.$": "$$.Task.Token",
          "iteration.$": "$.iteration"
        }
      },
      "ResultPath": "$.data_prep_generate",
      "TimeoutSeconds": 7200,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.TooManyRequestsException",
            "Lambda.AWSLambdaException"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "EscalateFail"
        }
      ],
      "Next": "DataPrepCurate"
    },
    "DataPrepCurate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${HarnessDriverArn}",
        "Payload": {
          "run_id.$": "$.run_id",
          "manifest_uri.$": "$.manifest_uri",
          "stage": "data-prep",
          "task": "curate",
          "harness_id": "llmops_data_prep",
          "task_token.$": "$$.Task.Token",
          "iteration.$": "$.iteration"
        }
      },
      "ResultPath": "$.data_prep_curate",
      "TimeoutSeconds": 7200,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "EscalateFail"
        }
      ],
      "Next": "FinetuneLaunch"
    },
    "FinetuneLaunch": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${HarnessDriverArn}",
        "Payload": {
          "run_id.$": "$.run_id",
          "manifest_uri.$": "$.manifest_uri",
          "stage": "finetune",
          "task": "launch",
          "harness_id": "llmops_finetune",
          "task_token.$": "$$.Task.Token",
          "iteration.$": "$.iteration"
        }
      },
      "ResultPath": "$.training",
      "TimeoutSeconds": 21600,
      "HeartbeatSeconds": 18000,
      "Catch": [
        {
          "ErrorEquals": [
            "TrainingJobFailed"
          ],
          "ResultPath": "$.error",
          "Next": "RemediationChoice"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "EscalateFail"
        }
      ],
      "Next": "FinetuneAnalyze"
    },
    "FinetuneAnalyze": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${HarnessDriverArn}",
        "Payload": {
          "run_id.$": "$.run_id",
          "manifest_uri.$": "$.manifest_uri",
          "stage": "finetune",
          "task": "analyze",
          "harness_id": "llmops_finetune",
          "task_token.$": "$$.Task.Token",
          "iteration.$": "$.iteration"
        }
      },
      "ResultPath": "$.training_analysis",
      "TimeoutSeconds": 3600,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "EscalateFail"
        }
      ],
      "Next": "EvalGate"
    },
    "EvalGate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${HarnessDriverArn}",
        "Payload": {
          "run_id.$": "$.run_id",
          "manifest_uri.$": "$.manifest_uri",
          "stage": "eval",
          "task": "gate",
          "harness_id": "llmops_eval",
          "task_token.$": "$$.Task.Token",
          "iteration.$": "$.iteration"
        }
      },
      "ResultPath": "$.evaluation",
      "TimeoutSeconds": 7200,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "EscalateFail"
        }
      ],
      "Next": "QualityGateChoice"
    },
    "QualityGateChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.evaluation.gate_passed",
          "BooleanEquals": true,
          "Next": "Deploy"
        }
      ],
      "Default": "RemediationChoice"
    },
    "RemediationChoice": {
      "Type": "Choice",
      "Comment": "Self-iteration budget: remediate while iteration < 3, then escalate to human.",
      "Choices": [
        {
          "Variable": "$.iteration",
          "NumericLessThan": 3,
          "Next": "IncrementIteration"
        }
      ],
      "Default": "EscalateFail"
    },
    "IncrementIteration": {
      "Type": "Pass",
      "Parameters": {
        "run_id.$": "$.run_id",
        "manifest_uri.$": "$.manifest_uri",
        "iteration.$": "States.MathAdd($.iteration, 1)"
      },
      "Next": "RemediateFinetune"
    },
    "RemediateFinetune": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${HarnessDriverArn}",
        "Payload": {
          "run_id.$": "$.run_id",
          "manifest_uri.$": "$.manifest_uri",
          "stage": "finetune",
          "task": "remediate",
          "harness_id": "llmops_finetune",
          "task_token.$": "$$.Task.Token",
          "iteration.$": "$.iteration"
        }
      },
      "ResultPath": "$.remediation",
      "TimeoutSeconds": 21600,
      "HeartbeatSeconds": 18000,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "EscalateFail"
        }
      ],
      "Next": "FinetuneAnalyze"
    },
    "Deploy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${HarnessDriverArn}",
        "Payload": {
          "run_id.$": "$.run_id",
          "manifest_uri.$": "$.manifest_uri",
          "stage": "deploy",
          "task": "deploy",
          "harness_id": "llmops_deploy",
          "task_token.$": "$$.Task.Token",
          "iteration.$": "$.iteration"
        }
      },
      "ResultPath": "$.deployment",
      "TimeoutSeconds": 7200,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "EscalateFail"
        }
      ],
      "Next": "SmokeTest"
    },
    "SmokeTest": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${HarnessDriverArn}",
        "Payload": {
          "run_id.$": "$.run_id",
          "manifest_uri.$": "$.manifest_uri",
          "stage": "deploy",
          "task": "smoke",
          "harness_id": "llmops_deploy",
          "task_token.$": "$$.Task.Token",
          "iteration.$": "$.iteration"
        }
      },
      "ResultPath": "$.smoke",
      "TimeoutSeconds": 3600,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Teardown"
        }
      ],
      "Next": "Teardown"
    },
    "Teardown": {
      "Type": "Task",
      "Comment": "Always runs after deploy \u2014 orphaned endpoints are the #1 cost risk.",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${HarnessDriverArn}",
        "Payload": {
          "run_id.$": "$.run_id",
          "manifest_uri.$": "$.manifest_uri",
          "stage": "deploy",
          "task": "teardown",
          "harness_id": "llmops_deploy",
          "task_token.$": "$$.Task.Token",
          "iteration.$": "$.iteration"
        }
      },
      "ResultPath": "$.teardown",
      "TimeoutSeconds": 3600,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "EscalateFail"
        }
      ],
      "Next": "Complete"
    },
    "Complete": {
      "Type": "Task",
      "Comment": "ResultPath keeps $.run_id and $.task_id in the state for MarkTaskDone. Same trap EscalateFail fell into: without it the PutEvents response becomes the whole state and the next state dies on a missing path.",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "Source": "llmops.pipeline",
            "DetailType": "PipelineCompleted",
            "EventBusName": "${EventBusName}",
            "Detail": {
              "run_id.$": "$.run_id",
              "iteration.$": "$.iteration"
            }
          }
        ]
      },
      "ResultPath": "$.complete_event",
      "Next": "MarkRunDone"
    },
    "MarkRunDone": {
      "Type": "Task",
      "Comment": "The success-path twin of MarkRunFailed, and the asymmetry it closes was live for as long as the failure path was fixed: runs.status was only ever written 'running' (start_pipeline), 'escalated' (the driver) or 'failed' (MarkRunFailed). NOTHING wrote 'completed'. stage_complete updates the manifest and settles the task token; it never touches the run's own status. So a run that succeeded stayed at status=running forever while its execution read SUCCEEDED -- the same zombie MarkRunFailed exists to prevent, on the happy path. It went unseen because until run-20260801T062313Z-4d3e2e69 no execution had ever SUCCEEDED; the fix for the failure path could not have revealed it. Observed 2026-08-01: that run's task row closed correctly at 06:34:43Z while its run row still read 'running' five hours later. ConditionExpression mirrors MarkRunFailed's so a richer terminal status already written by the driver (escalated) is kept rather than overwritten, and Catch: States.ALL means a rejected condition or a DDB outage cannot fail an execution whose pipeline genuinely succeeded.",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:updateItem",
      "Parameters": {
        "TableName": "llmops-pipeline-runs",
        "Key": {
          "run_id": {
            "S.$": "$.run_id"
          }
        },
        "UpdateExpression": "SET #s = :done, completed_at = :now",
        "ConditionExpression": "attribute_not_exists(#s) OR #s = :running",
        "ExpressionAttributeNames": {
          "#s": "status"
        },
        "ExpressionAttributeValues": {
          ":done": {
            "S": "completed"
          },
          ":running": {
            "S": "running"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Comment": "Both exits go to MarkTaskDone for the same reason MarkRunFailed's Catch goes to MarkTaskFailed: the run record and the task record are separate records with separate reasons to go stale, so failing to close one must not leave the other open.",
          "ResultPath": null,
          "Next": "MarkTaskDone"
        }
      ],
      "Next": "MarkTaskDone"
    },
    "MarkTaskDone": {
      "Type": "Task",
      "Comment": "Close out the conductor's task record on the SUCCESS path. A run dispatched from an approved plan has two records with lifecycles -- the run and the llmops-tasks row -- and only the run was ever closed, so the console's Tasks tab showed a finished order as still in flight and the audit trail never recorded how it ended. llmops-tasks is written only by the console Lambda, which is not in the execution path, so the state machine does it, as it already does for the run record. The ConditionExpression makes the NO_TASK sentinel a no-op: most runs (schedule, webhook) have no task, and attempting the write anyway would either mint a phantom task row or fail a healthy execution.",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:updateItem",
      "Parameters": {
        "TableName": "llmops-tasks",
        "Key": {
          "id": {
            "S.$": "$.task_id"
          }
        },
        "UpdateExpression": "SET #s = :done, closed_at = :now, final_run_status = :done",
        "ConditionExpression": "attribute_exists(id) AND #s = :dispatched",
        "ExpressionAttributeNames": {
          "#s": "status"
        },
        "ExpressionAttributeValues": {
          ":done": {
            "S": "completed"
          },
          ":dispatched": {
            "S": "dispatched"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Comment": "No task (sentinel), or a task already in a richer terminal state. Neither is a run failure -- the run genuinely succeeded, so swallow and end.",
          "ResultPath": null,
          "Next": "Succeed"
        }
      ],
      "Next": "Succeed"
    },
    "Succeed": {
      "Type": "Succeed"
    },
    "EscalateFail": {
      "Type": "Task",
      "Comment": "ResultPath files the PutEvents response under a key instead of letting it become the whole state. Without it, a Task's result REPLACES its input -- and the next state, MarkRunFailed, reads $.run_id, which a PutEvents response does not contain. The zombie-closeout fix would have failed on a missing path at the exact moment it was needed, leaving the run at status=running: the bug it was written to fix.",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "Source": "llmops.pipeline",
            "DetailType": "EscalatedToHuman",
            "EventBusName": "${EventBusName}",
            "Detail": {
              "run_id.$": "$.run_id",
              "iteration.$": "$.iteration"
            }
          }
        ]
      },
      "ResultPath": "$.escalate_fail",
      "Next": "MarkRunFailed"
    },
    "Fail": {
      "Type": "Fail",
      "Error": "PipelineFailed",
      "Cause": "Terminal failure or remediation budget exhausted \u2014 see EscalatedToHuman event, SNS, and DDB stage events."
    },
    "MarkRunFailed": {
      "Type": "Task",
      "Comment": "Close out the run record. Every Python writer of runs.status lives inside a stage Lambda, so a stage that CRASHES leaves the run at status=running forever while its execution is FAILED -- a zombie the console shows as live. The state machine is the only participant still alive when a stage dies, so it writes the terminal status itself, through the SDK integration rather than yet another Lambda. A rejected condition means the driver already wrote a RICHER terminal status (escalated) -- the Catch keeps it and carries on to Fail. Catching States.ALL also means a DDB outage cannot hang the execution: the run still ends FAILED, just without the marker.",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:updateItem",
      "Parameters": {
        "TableName": "llmops-pipeline-runs",
        "Key": {
          "run_id": {
            "S.$": "$.run_id"
          }
        },
        "UpdateExpression": "SET #s = :failed, failed_at = :now",
        "ConditionExpression": "attribute_not_exists(#s) OR #s = :running",
        "ExpressionAttributeNames": {
          "#s": "status"
        },
        "ExpressionAttributeValues": {
          ":failed": {
            "S": "failed"
          },
          ":running": {
            "S": "running"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": null,
          "Next": "MarkTaskFailed"
        }
      ],
      "Next": "MarkTaskFailed"
    },
    "MarkTaskFailed": {
      "Type": "Task",
      "Comment": "The failure-path twin of MarkTaskDone. Both of MarkRunFailed's exits route here, including its Catch: a DDB error while closing the RUN must not stop us from closing the TASK, since those are separate records and separate reasons to be stale. Observed live: task-58ecde82adcd73bf sat at 'dispatched' for a day after run-20260731T183103Z-8b864805 read 'failed', because nothing on this path wrote the task at all. Ends at Fail either way, so the execution still reports FAILED.",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:updateItem",
      "Parameters": {
        "TableName": "llmops-tasks",
        "Key": {
          "id": {
            "S.$": "$.task_id"
          }
        },
        "UpdateExpression": "SET #s = :failed, closed_at = :now, final_run_status = :failed",
        "ConditionExpression": "attribute_exists(id) AND #s = :dispatched",
        "ExpressionAttributeNames": {
          "#s": "status"
        },
        "ExpressionAttributeValues": {
          ":failed": {
            "S": "failed"
          },
          ":dispatched": {
            "S": "dispatched"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Comment": "No task (sentinel) or already terminal -- the run still failed, so go to Fail regardless.",
          "ResultPath": null,
          "Next": "Fail"
        }
      ],
      "Next": "Fail"
    }
  }
}
